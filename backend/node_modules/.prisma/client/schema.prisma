generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  phone         String?
  address       String?
  role          UserRole       @default(DONOR)
  profileImage  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  chatHistory   ChatHistory[]
  donations     Donation[]
  equipment     Equipment[]
  notifications Notification[]
  requests      Request[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Equipment {
  id           String             @id @default(cuid())
  name         String
  category     String
  manufacturer String?
  description  String?
  quantity     Int                @default(1)
  condition    EquipmentCondition
  status       EquipmentStatus    @default(AVAILABLE)
  image        String?
  ownerId      String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  donations    Donation[]
  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requests     Request[]

  @@index([ownerId])
  @@index([status])
  @@index([category])
  @@index([condition])
  @@index([status, category])
  @@index([ownerId, status])
  @@index([createdAt])
  @@map("equipment")
}

model Donation {
  id          String         @id @default(cuid())
  equipmentId String
  donorId     String
  status      DonationStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  donor       User           @relation(fields: [donorId], references: [id], onDelete: Cascade)
  equipment   Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([donorId])
  @@index([status])
  @@index([donorId, status])
  @@index([createdAt])
  @@map("donations")
}

model Request {
  id          String        @id @default(cuid())
  equipmentId String
  requesterId String
  reason      String?
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  equipment   Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  requester   User          @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([requesterId])
  @@index([status])
  @@index([requesterId, status])
  @@index([equipmentId, status])
  @@index([createdAt])
  @@map("requests")
}

model Hospital {
  id           String   @id @default(cuid())
  hospitalName String
  address      String
  city         String
  state        String
  pincode      String
  phone        String?
  email        String?  @unique
  website      String?
  description  String?
  latitude     Float?
  longitude    Float?
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([city])
  @@index([state])
  @@index([pincode])
  @@index([state, city])
  @@index([latitude, longitude])
  @@map("hospitals")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model ChatHistory {
  id          String   @id @default(cuid())
  userId      String
  userMessage String
  botReply    String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_history")
}

enum UserRole {
  ADMIN
  DONOR
  NGO
  RECIPIENT
}

enum EquipmentCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum EquipmentStatus {
  AVAILABLE
  REQUESTED
  DONATED
  UNAVAILABLE
}

enum DonationStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}
