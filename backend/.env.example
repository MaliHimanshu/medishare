# ─────────────────────────────────────────────
# MediShare Backend – Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to Git.
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/medishare"

# ── Authentication ────────────────────────────
# Use a strong random secret (min 32 characters)
JWT_SECRET="your_super_secret_jwt_key_minimum_32_characters"

# ── Google Gemini AI ──────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# ── File Uploads ──────────────────────────────
# Base URL used to build image URLs in API responses
BASE_URL="http://localhost:5000"

# ── Twilio SMS Gateway ────────────────────────
# Required for live OTP SMS delivery to phone numbers
TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"



