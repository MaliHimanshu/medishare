generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// USER
// ======================================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  phone        String?
  address      String?
  role         UserRole @default(DONOR)
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chatHistory   ChatHistory[]
  donations     Donation[]
  equipment     Equipment[]
  notifications Notification[]
  requests      Request[]
  rentals       Rental[]       @relation("Renter")

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// ======================================================
// EQUIPMENT
// ======================================================

model Equipment {
  id           String             @id @default(cuid())
  name         String
  category     String
  manufacturer String?
  description  String?
  quantity     Int                @default(1)
  condition    EquipmentCondition
  image        String?
  images       String[]           @default([])
  mode         EquipmentMode      @default(DONATE)
  status       EquipmentStatus    @default(AVAILABLE)

  rentalPricePerDay Decimal? @db.Decimal(10, 2)
  securityDeposit   Decimal? @db.Decimal(10, 2)

  latitude  Float?
  longitude Float?
  address   String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  rentals   Rental[]
  donations Donation[]
  requests  Request[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([condition])
  @@index([mode])
  @@index([status])
  @@index([ownerId])
  @@index([ownerId, status])
  @@index([status, category])
  @@index([latitude, longitude])
  @@index([createdAt])
  @@map("equipment")
}

// ======================================================
// RENTAL
// ======================================================

model Rental {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  renterId String
  renter   User   @relation("Renter", fields: [renterId], references: [id])

  startDate    DateTime
  endDate      DateTime
  numberOfDays Int

  rentalAmount    Decimal @db.Decimal(10, 2)
  securityDeposit Decimal @db.Decimal(10, 2)
  totalAmount     Decimal @db.Decimal(10, 2)

  status        RentalStatus  @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  razorpayOrderId   String?
  razorpayPaymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipmentId])
  @@index([renterId])
  @@index([status])
  @@index([paymentStatus])
  @@index([startDate, endDate])
  @@map("rentals")
}

// ======================================================
// DONATION
// ======================================================

model Donation {
  id          String         @id @default(cuid())
  equipmentId String
  donorId     String
  status      DonationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donor     User      @relation(fields: [donorId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([donorId])
  @@index([status])
  @@index([donorId, status])
  @@index([createdAt])
  @@map("donations")
}

// ======================================================
// EQUIPMENT REQUEST
// ======================================================

model Request {
  id          String        @id @default(cuid())
  equipmentId String
  requesterId String
  reason      String?
  status      RequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  requester User      @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([requesterId])
  @@index([status])
  @@index([requesterId, status])
  @@index([equipmentId, status])
  @@index([createdAt])
  @@map("requests")
}

// ======================================================
// HOSPITAL
// ======================================================

model Hospital {
  id           String @id @default(cuid())
  hospitalName String
  address      String
  city         String
  state        String
  pincode      String

  phone       String?
  email       String? @unique
  website     String?
  description String?

  latitude  Float?
  longitude Float?
  image     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([state])
  @@index([pincode])
  @@index([state, city])
  @@index([latitude, longitude])
  @@map("hospitals")
}

// ======================================================
// NOTIFICATION
// ======================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(GENERAL)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ======================================================
// AI CHAT HISTORY
// ======================================================

model ChatHistory {
  id          String   @id @default(cuid())
  userId      String
  userMessage String
  botReply    String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_history")
}

// ======================================================
// ENUMS
// ======================================================

enum UserRole {
  ADMIN
  DONOR
  NGO
  RECIPIENT
}

enum EquipmentCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum EquipmentMode {
  DONATE
  RENT
  BOTH
}

enum EquipmentStatus {
  AVAILABLE
  RESERVED
  RENTED
  DONATED
  MAINTENANCE
}

enum RentalStatus {
  PENDING
  APPROVED
  ACTIVE
  RETURNED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DonationStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  REQUEST
  DONATION
  APPROVAL
  REJECTION
  GENERAL
}
