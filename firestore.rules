rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserRole() {
      // Assumes custom claims or a users collection read
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'ADMIN';
    }

    function isNGO(ngoId) {
      return isAuthenticated() && getUserRole() == 'NGO' && request.auth.uid == ngoId;
    }

    function isDeliveryPartner() {
      return isAuthenticated() && getUserRole() == 'DELIVERY_PARTNER';
    }
    
    function isRecipient() {
      return isAuthenticated() && getUserRole() == 'RECIPIENT';
    }

    // Rentals Collection
    match /rentals/{rentalId} {
      allow read: if isUser(resource.data.renterId) || isNGO(resource.data.ngoId) || isUser(resource.data.ownerId) || isAdmin();
      allow create: if isRecipient() && request.resource.data.renterId == request.auth.uid && request.resource.data.status == 'REQUESTED';
      
      // Update restrictions based on role
      allow update: if isAdmin() || (isNGO(resource.data.ngoId) && 
                         (request.resource.data.status in ['APPROVED', 'REJECTED', 'PARTNER_ASSIGNED', 'COMPLETED', 'DISPUTED'])) ||
                       (isUser(resource.data.renterId) && 
                         (request.resource.data.status in ['ACTIVE', 'RETURN_REQUESTED'])) ||
                       (isDeliveryPartner() && 
                         (request.resource.data.status in ['OUT_FOR_PICKUP', 'PICKED_UP', 'DELIVERED', 'RETURN_PICKUP', 'RETURNED', 'ACTIVE']));
      allow delete: if false; // Soft deletes only
    }

    // Deliveries Collection
    match /deliveries/{deliveryId} {
      allow read: if isAdmin() || isUser(resource.data.deliveryPartnerId) || isNGO(resource.data.ngoId) || 
                  (isRecipient() && get(/databases/$(database)/documents/rentals/$(resource.data.rentalId)).data.renterId == request.auth.uid);
      allow create: if isAdmin() || isNGO(request.resource.data.ngoId);
      
      allow update: if isAdmin() || 
                    isNGO(resource.data.ngoId) ||
                    (isUser(resource.data.deliveryPartnerId) &&
                     request.resource.data.rentalId == resource.data.rentalId &&
                     request.resource.data.deliveryPartnerId == resource.data.deliveryPartnerId &&
                     request.resource.data.ngoId == resource.data.ngoId &&
                     request.resource.data.type == resource.data.type &&
                     request.resource.data.pickupAddress == resource.data.pickupAddress &&
                     request.resource.data.deliveryAddress == resource.data.deliveryAddress
                    );
      
      allow delete: if isAdmin();
    }

    // Equipment Collection
    match /equipment/{equipmentId} {
      allow read: if true; // Public catalog
      allow create: if (request.resource.data.keys().hasAny(['ngoId']) && isNGO(request.resource.data.ngoId)) || isUser(request.resource.data.ownerId) || isAdmin();
      allow update: if (resource.data.keys().hasAny(['ngoId']) && isNGO(resource.data.ngoId)) || isUser(resource.data.ownerId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Delivery Partners
    match /deliveryPartners/{partnerId} {
      allow read: if isUser(partnerId) || isNGO(resource.data.ngoId) || isAdmin();
      allow update: if isUser(partnerId) || isNGO(resource.data.ngoId) || isAdmin();
      allow create, delete: if isAdmin();
    }

    // Evidence Collection
    match /evidence/{evidenceId} {
      allow read: if isAuthenticated() && (
        resource.data.uploadedBy == request.auth.uid ||
        isAdmin() ||
        (resource.data.get('deliveryId', null) != null && get(/databases/$(database)/documents/deliveries/$(resource.data.deliveryId)).data.deliveryPartnerId == request.auth.uid) ||
        (resource.data.get('rentalId', null) != null && isNGO(get(/databases/$(database)/documents/rentals/$(resource.data.rentalId)).data.ngoId))
      );

      allow create: if isAuthenticated() && request.resource.data.uploadedBy == request.auth.uid && (
        isAdmin() ||
        (request.resource.data.get('deliveryId', null) != null && get(/databases/$(database)/documents/deliveries/$(request.resource.data.deliveryId)).data.deliveryPartnerId == request.auth.uid) ||
        (request.resource.data.get('rentalId', null) != null && isNGO(get(/databases/$(database)/documents/rentals/$(request.resource.data.rentalId)).data.ngoId))
      );

      allow update, delete: if isAuthenticated() && resource.data.uploadedBy == request.auth.uid;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isUser(userId) || getUserRole() == 'NGO' || isAdmin();
      allow write: if isUser(userId) || isAdmin();
      
      // Allow users to manage their own notification tokens
      match /notificationTokens/{token} {
        allow read, write: if isUser(userId);
      }
    }
  }
}
